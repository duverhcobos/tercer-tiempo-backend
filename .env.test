# Base de datos de testing
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_DATABASE=nestjs_ddd_starter_test

# JWT
JWT_SECRET=test-secret-key-for-testing-only
JWT_EXPIRES_IN=1h

# Logging (menos verbose en tests)
LOG_LEVEL=error

# Rate Limiting (muy permisivo en tests para evitar bloqueos)
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000
